<%@ Master Language="C#" AutoEventWireup="true" CodeFile="GuestRoom.master.cs" Inherits="GuestRoomMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %>Guest Room Management</title>
    
    <!-- CSS Files - Using ResolveUrl (reliable in precompiled apps) -->
    <link href="<%= ResolveUrl("~/MemberShipModule/assets/css/print.css?v=1.0") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/MemberShipModule/assets/css/MemberShipStyles.css?v=2.0") %>" rel="stylesheet" />
    
    <!-- External Resources -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* ===== Base Reset ===== */
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { font-size: 16px; scroll-behavior: smooth; }
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #f1f5f9; color: #0f172a; min-height: 100vh;
            line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: hidden;
        }
        form { width: 100%; display: block; }

        /* ===== Layout Architecture ===== */
        .app-container { display: flex; width: 100%; min-height: 100vh; position: relative; }
        .sidebar {
            width: 280px; background-color: #0f172a; color: #ffffff;
            display: flex; flex-direction: column; position: fixed; height: 100vh;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.2);
            left: 0; top: 0; bottom: 0; z-index: 1000;
        }
        .main-wrapper {
            margin-left: 280px; display: flex; flex-direction: column;
            width: auto; flex: 1; min-height: 100vh; position: relative;
            background-color: #f1f5f9; overflow-x: visible; z-index: 1;
        }
        .top-header {
            height: 72px; background-color: #ffffff; border-bottom: 1px solid #e2e8f0;
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 2rem; position: sticky; top: 0; z-index: 900; width: 100%;
            box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        }
        .top-header h2 { font-size: 1.25rem; font-weight: 700; color: #0f172a; margin: 0; }
        .user-menu { display: flex; align-items: center; gap: 1rem; font-weight: 600; font-size: 0.95rem; }
        .user-menu > div { display: flex; align-items: center; gap: 0.5rem; color: #334155; }
        .user-menu .fa-user-circle { font-size: 1.4rem; color: #2563eb; }
        /* ===== Employee Info Strip ===== */
        .emp-info-strip {
            background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
            border-bottom: 1px solid #e2e8f0;
            padding: 0.5rem 2rem;
            display: flex;
            align-items: center;
            gap: 1.5rem;
            flex-wrap: wrap;
            font-size: 0.8rem;
            color: #475569;
        }
        .emp-info-item {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }
        .emp-info-item i {
            color: #2563eb;
            font-size: 0.75rem;
            width: 14px;
            text-align: center;
        }
        .emp-info-item .info-label {
            font-weight: 600;
            color: #334155;
        }
        .emp-info-item .info-value {
            font-weight: 400;
            color: #64748b;
        }
        .emp-info-divider {
            width: 1px;
            height: 16px;
            background: #cbd5e1;
        }
        .header-content { display: flex; align-items: center; gap: 1rem; }
        .header-content h2 { margin: 0; font-size: 1.15rem; font-weight: 700; color: #0f172a; line-height: 1.2; }
        .club-branding { font-size: 0.8rem; color: #64748b; font-weight: 500; display: block; line-height: 1.3; }
        .toggle-btn {
            display: inline-flex; align-items: center; justify-content: center;
            width: 40px; height: 40px; border-radius: 8px; border: 1px solid #e2e8f0;
            background: #f8fafc; color: #334155; font-size: 1.1rem; cursor: pointer;
            transition: all 0.2s ease; flex-shrink: 0;
        }
        .toggle-btn:hover { background: #e2e8f0; color: #0f172a; }
        .btn-sm {
            display: inline-flex; align-items: center; gap: 0.4rem;
            padding: 0.45rem 0.9rem; font-size: 0.8rem; font-weight: 600;
            border-radius: 6px; cursor: pointer; transition: all 0.15s ease;
            border: 1px solid #e2e8f0; background: #f8fafc; color: #475569;
            text-decoration: none; line-height: 1;
        }
        .btn-sm:hover { background: #fee2e2; border-color: #fecaca; color: #dc2626; }
        .btn-sm .fa-sign-out-alt { font-size: 0.85rem; }
        .btn-sm.flex { display: inline-flex; align-items: center; justify-content: center; }

        /* ===== Sidebar Collapse ===== */
        .sidebar.collapsed { width: 0; overflow: hidden; padding: 0; }
        .sidebar.collapsed .sidebar-header, .sidebar.collapsed .nav-links { opacity: 0; pointer-events: none; }
        .sidebar-collapsed .main-wrapper { margin-left: 0; }

        /* ===== Sidebar Navigation ===== */
        .dropdown-toggle { display: flex; align-items: center; justify-content: space-between; }
        .dropdown-toggle svg { transition: transform 0.25s ease; flex-shrink: 0; opacity: 0.6; }
        .nav-dropdown.active > .dropdown-toggle svg { transform: rotate(180deg); opacity: 1; }
        .dropdown-item-divider { height: 1px; background: rgba(255,255,255,0.08); margin: 0.5rem 1rem; list-style: none; }
        .content-area { padding: 1.25rem; flex-grow: 1; width: 100%; margin: 0; max-width: 100% !important; }
        .page-wrapper { width: 100%; max-width: 100%; }
        .sidebar-header {
            height: 72px; display: flex; align-items: center; padding: 0 1.5rem;
            font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em;
            color: #ffffff; background: transparent; margin-bottom: 1rem;
        }
        .nav-links {
            list-style: none; padding: 0 1rem; flex-grow: 1;
            overflow-y: auto; overflow-x: hidden; display: flex;
            flex-direction: column; gap: 4px;
        }
        .nav-links::-webkit-scrollbar { width: 6px; }
        .nav-links::-webkit-scrollbar-track { background: transparent; }
        .nav-links::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }
        .nav-links::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.4); }
        .nav-link {
            display: block; padding: 10px 16px; color: #94a3b8; text-decoration: none;
            border-radius: 99px; transition: all 0.2s ease; font-weight: 500;
            font-size: 0.95rem; position: relative;
        }
        .nav-link:hover { color: #ffffff; background: rgba(255,255,255,0.08); transform: none; }
        .nav-link.active { background: #2563eb; color: white; font-weight: 600; box-shadow: 0 4px 12px rgba(37,99,235,0.25); }
        .nav-dropdown.active .dropdown-menu { display: block; animation: fadeIn 0.2s ease-out; }
        .dropdown-menu {
            display: none; margin-top: 4px; margin-bottom: 0.5rem; list-style: none;
            padding-left: 0; margin-left: 12px; border-left: 1px solid rgba(255,255,255,0.1);
        }
        .dropdown-link {
            display: block; padding: 8px 16px 8px 24px; color: #94a3b8; text-decoration: none;
            font-size: 0.9rem; transition: all 0.2s ease; border-radius: 0 99px 99px 0; margin-left: 4px;
        }
        .dropdown-link:hover { color: #ffffff; background: rgba(255,255,255,0.05); }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(-2px); } to { opacity: 1; transform: translateY(0); } }
        .main-footer {
            background-color: #ffffff; border-top: 1px solid #e2e8f0;
            padding: 1.5rem 2rem; display: flex; justify-content: space-between;
            align-items: center; margin-top: auto; z-index: 10;
        }
        .main-footer p { margin: 0; font-size: 0.875rem; color: #64748b; }
        .main-footer strong { color: #0f172a; font-weight: 700; }
        @media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); width: 100%; }
            .sidebar.active { transform: translateX(0); }
            .main-wrapper { margin-left: 0; width: 100%; }
            .content-area { padding: 1rem; }
            .top-header { padding: 0 1rem; }
        }

        /* ===== Load More Button ===== */
        .load-more-container {
            padding: 0.75rem 1rem;
            text-align: center;
        }
        .btn-load-more {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            width: 100%;
            padding: 10px 16px;
            background: transparent;
            border: 1px dashed rgba(255, 255, 255, 0.2);
            color: #94a3b8;
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            font-weight: 500;
            border-radius: 99px;
            cursor: pointer;
            transition: all 0.25s ease;
            letter-spacing: 0.02em;
            text-decoration: none;
        }
        .btn-load-more:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.35);
            color: #ffffff;
        }
        .btn-load-more:active {
            transform: scale(0.97);
        }
        .btn-load-more .fa-chevron-down {
            font-size: 0.7rem;
            transition: transform 0.3s ease;
        }
        .btn-load-more:hover .fa-chevron-down {
            transform: translateY(2px);
        }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager ID="ScriptManagerMaster" runat="server" />
        <div class="app-container">
        
            <nav class="sidebar">
                <div class="sidebar-header">
                    Guest Room Management
                </div>
                <ul class="nav-links">
                    
                    <asp:UpdatePanel ID="upSidebar" runat="server" UpdateMode="Conditional">
                        <ContentTemplate>
                            <asp:Repeater ID="rptModules" runat="server" OnItemDataBound="rptModules_ItemDataBound">
                                <ItemTemplate>
                                    <li class="nav-item nav-dropdown" id='<%# "dynMod_" + Eval("Module_ID") %>'>
                                        <a href="javascript:void(0)" class="nav-link dropdown-toggle" onclick='<%# "toggleDropdown(\"dynMod_" + Eval("Module_ID") + "\")" %>'>
                                            <span><%# Eval("Module_Name") %></span>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                                            </svg>
                                        </a>
                                        <ul class="dropdown-menu">
                                            <asp:Repeater ID="rptPages" runat="server">
                                                <ItemTemplate>
                                                    <li class="dropdown-item">
                                                        <a href='<%# ResolveUrl(Eval("Page_URL").ToString()) %>' class="dropdown-link"><%# Eval("Page_Name") %></a>
                                                    </li>
                                                </ItemTemplate>
                                            </asp:Repeater>
                                        </ul>
                                    </li>
                                </ItemTemplate>
                            </asp:Repeater>

                            <!-- Load More Button -->
                            <li class="nav-item load-more-container" id="liLoadMore" runat="server">
                                <asp:LinkButton ID="btnLoadMore" runat="server" 
                                    CssClass="btn-load-more" 
                                    OnClick="btnLoadMore_Click"
                                    CausesValidation="false">
                                    <i class="fas fa-chevron-down"></i> Load More Modules
                                </asp:LinkButton>
                            </li>

                        </ContentTemplate>
                    </asp:UpdatePanel>

                    <li class="nav-item">
                        <a href='<%= ResolveUrl("~/Login.aspx") %>' class="nav-link">
                            <span>Logout</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <script>
                function toggleDropdown(id) {
                    const dropdown = document.getElementById(id);
                    dropdown.classList.toggle('active');
                }

                function toggleSidebar() {
                    const sidebar = document.querySelector('.sidebar');
                    const appContainer = document.querySelector('.app-container');

                    sidebar.classList.toggle('collapsed');
                    appContainer.classList.toggle('sidebar-collapsed');
                }
            </script>

            <!-- Main Content -->
            <div class="main-wrapper">
                <header class="top-header">
                    <!-- Left Side: Toggle & Logo -->
                    <div class="header-content">
                         <button type="button" class="toggle-btn" onclick="toggleSidebar()">
                             <i class="fas fa-bars"></i>
                         </button>
                         <img src='<%= ResolveUrl("~/MemberShipModule/assets/images/logo_new.png") %>' alt="Club Logo" style="height: 70px; width: auto; object-fit: contain;" />
                         <div>
                             <h2>Lahore GymKhana Club</h2>
                             <span class="club-branding"><%: Page.Title %></span>
                         </div>
                    </div>
                    
                    <!-- Right Side: User Menu & Logout -->
                    <div class="user-menu">
                        <div>
                            <i class="fas fa-user-circle"></i>
                            <asp:Label ID="lblUser" runat="server" Text="User"></asp:Label>
                        </div>
                        <asp:HyperLink runat="server" NavigateUrl="~/Login.aspx" CssClass="btn btn-sm">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </asp:HyperLink>
                    </div>
                </header>

                <!-- Employee Info Strip -->
                <div class="emp-info-strip" id="divEmpInfo" runat="server">
                    <div class="emp-info-item">
                        <i class="fas fa-user"></i>
                        <span class="info-label">Name:</span>
                        <asp:Label ID="lblEmpName" runat="server" CssClass="info-value" Text="-"></asp:Label>
                    </div>
                    <div class="emp-info-divider"></div>
                    <div class="emp-info-item">
                        <i class="fas fa-id-badge"></i>
                        <span class="info-label">Designation:</span>
                        <asp:Label ID="lblDesignation" runat="server" CssClass="info-value" Text="-"></asp:Label>
                    </div>
                    <div class="emp-info-divider"></div>
                    <div class="emp-info-item">
                        <i class="fas fa-building"></i>
                        <span class="info-label">Department:</span>
                        <asp:Label ID="lblDepartment" runat="server" CssClass="info-value" Text="-"></asp:Label>
                    </div>
                    <div class="emp-info-divider"></div>
                    <div class="emp-info-item">
                        <i class="fas fa-sitemap"></i>
                        <span class="info-label">Sub Department:</span>
                        <asp:Label ID="lblSubDept" runat="server" CssClass="info-value" Text="-"></asp:Label>
                    </div>
                </div>

                <main class="content-area">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>

                <footer class="main-footer">
                    <p>Powered by <strong>MegaPlus Technologies</strong></p>
                    <p class="copyright">&copy; 2024 Lahore Gymkhana Club. All rights reserved by MegaPlus</p>
                </footer>
            </div>
        </div>
    </form>
    <script src='<%= ResolveUrl("~/MemberShipModule/assets/js/rfid-scanner.js") %>'></script>
    <script src='<%= ResolveUrl("~/MemberShipModule/assets/js/report-preview.js") %>'></script>
    <script type="text/javascript">
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                var activeElement = document.activeElement;
                if (activeElement.tagName === 'INPUT' || activeElement.tagName === 'SELECT') {
                    if (activeElement.type !== 'submit' && activeElement.type !== 'button') {
                        e.preventDefault();
                        var focusableElements = Array.from(document.querySelectorAll(
                            'input:not([type="hidden"]):not([disabled]):not([readonly]), ' +
                            'select:not([disabled]):not([readonly]), ' +
                            'textarea:not([disabled]):not([readonly]), ' +
                            'button:not([disabled])'
                        ));
                        var currentIndex = focusableElements.indexOf(activeElement);
                        if (currentIndex > -1 && currentIndex < focusableElements.length - 1) {
                            focusableElements[currentIndex + 1].focus();
                        }
                    }
                }
            }
        });
    </script>
</body>
</html>