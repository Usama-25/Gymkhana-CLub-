<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Complaint.Master.cs" Inherits="Masters_Complaint" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lahore Gymkhana Club - Complaint & Feedback Portal</title>
    
    <!-- Premium Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <asp:ContentPlaceHolder ID="cphHead" runat="server" />
    <style>
        @media print {
            .no-print, aside, header, #appSidebar {
                display: none !important;
            }
            #mainContent {
                margin-left: 0 !important;
                padding: 0 !important;
            }
        }

        /* Premium GridView Global Styles */
        .gv-header {
            background-color: #0f1e36 !important;
            color: #ffffff !important;
            font-weight: 600 !important;
            text-transform: uppercase !important;
            font-size: 11.5px !important;
            letter-spacing: 0.5px !important;
            padding: 12px 16px !important;
            border-bottom: 2px solid #c5a059 !important;
        }

        .gv-header-left {
            background-color: #0f1e36 !important;
            color: #ffffff !important;
            font-weight: 600 !important;
            font-size: 11.5px !important;
            padding: 12px 16px !important;
            text-align: left !important;
            border-bottom: 2px solid #c5a059 !important;
        }

        .gv-row {
            background-color: #ffffff !important;
        }

        .gv-row td, .gv-alt-row td {
            border-bottom: 1px solid #e2e8f0 !important;
            padding: 12px 16px !important;
        }

        .gv-alt-row {
            background-color: #f8fafc !important;
        }

        /* Column alignments */
        .gv-text-left {
            text-align: left !important;
        }
        .gv-text-center {
            text-align: center !important;
        }
        .gv-text-right {
            text-align: right !important;
        }

        /* Pager formatting */
        .pager-style {
            background-color: #f8fafc !important;
            padding: 12px !important;
            border-top: 1px solid #e2e8f0 !important;
            text-align: right !important;
        }
        .pager-style td {
            border: none !important;
            padding: 0 4px !important;
        }
        
        /* Sidebar Hover Dropdown Styles */
        .sidebar-module {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .sidebar-module-pages {
            display: none;
            list-style: none;
            padding: 0 4px;
            margin: 0;
        }
        .sidebar-module:hover .sidebar-module-pages {
            display: block;
            animation: sidebarFadeIn 0.25s ease-out;
        }
        .sidebar-module:hover .sidebar-module-heading {
            color: #c5a059 !important;
        }
        .sidebar-module:hover .sidebar-module-heading i {
            transform: rotate(90deg);
            color: #c5a059;
            opacity: 1;
        }
        @keyframes sidebarFadeIn {
            from { opacity: 0; transform: translateY(-6px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body style="font-family: 'Outfit', sans-serif; background-color: #f8fafc; color: #1e293b; min-height: 100vh; display: flex; overflow-x: hidden; -webkit-font-smoothing: antialiased; margin: 0; padding: 0;">
    <form id="form1" runat="server" style="width: 100%; display: flex;">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" />
        <div style="display: flex; width: 100%; min-height: 100vh;">
            <!-- ══════════════════════════════════════════════════════════
                 SIDEBAR NAVIGATION (DEDICATED COMPLAINT SYSTEM)
            ═══════════════════════════════════════════════════════════ -->
            <aside id="appSidebar" style="width: 280px; background: linear-gradient(180deg, #0f1e36 0%, #08101e 100%); color: #ffffff; height: 100vh; position: fixed; left: 0; top: 0; display: flex; flex-direction: column; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.08); z-index: 100; border-right: 1px solid rgba(255,255,255,0.05); transition: all 0.25s ease; opacity: 1; pointer-events: auto;">
                <div style="padding: 24px 20px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid rgba(255,255,255,0.06); background-color: rgba(0,0,0,0.15);">
                    <div style="width: 42px; height: 42px; background: linear-gradient(135deg, #c5a059 0%, #aa8441 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: #0f1e36; box-shadow: 0 0 15px rgba(197, 160, 89, 0.4); border: 2px solid rgba(255,255,255,0.25);">C</div>
                    <div style="display: block;">
                        <h1 style="font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; letter-spacing: 0.3px; color: #ffffff; line-height: 1.2; margin: 0;">Complaints Management</h1>
                        <p style="font-size: 9px; color: #c5a059; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; margin-top: 2px; margin-bottom: 0;">Feedback & Quality Portal</p>
                    </div>
                </div>

                <ul style="flex: 1; padding: 24px 16px; list-style: none; overflow-y: auto; margin: 0;">
                    <asp:UpdatePanel ID="upSidebar" runat="server" UpdateMode="Conditional">
                        <ContentTemplate>
                            <asp:Repeater ID="rptModules" runat="server" OnItemDataBound="rptModules_ItemDataBound">
                                <ItemTemplate>
                                    <li class="sidebar-module">
                                        <div class="sidebar-module-heading" style='<%# "font-size: 12.5px; color: rgba(255,255,255,0.85); text-transform: uppercase; letter-spacing: 1.2px; margin-bottom: 10px; padding: 8px 12px; font-weight: 800; cursor: pointer; transition: color 0.2s ease; " + (Container.ItemIndex == 0 ? "margin-top: 0px;" : "margin-top: 20px;") %>'>
                                            <%# Eval("Module_Name") %>
                                            <i class="fas fa-chevron-right" style="font-size: 8px; float: right; margin-top: 3px; opacity: 0.5; transition: transform 0.2s ease;"></i>
                                        </div>
                                        <ul class="sidebar-module-pages">
                                            <asp:Repeater ID="rptPages" runat="server">
                                                <ItemTemplate>
                                                    <li style="margin-bottom: 6px; list-style: none;">
                                                        <a href='<%# ResolveUrl("~/" + Eval("Page_URL").ToString().TrimStart('~').TrimStart('/')) %>' style="display: flex; align-items: center; gap: 14px; padding: 11px 16px; text-decoration: none; border-radius: 8px; font-size: 14px; font-weight: 700; transition: all 0.25s ease; <%# GetActiveStyle(Eval("Page_URL").ToString()) %>">
                                                            <span><%# Eval("Page_Name") %></span>
                                                        </a>
                                                    </li>
                                                </ItemTemplate>
                                            </asp:Repeater>
                                        </ul>
                                    </li>
                                </ItemTemplate>
                            </asp:Repeater>
                            
                            <!-- Load More Button -->
                            <li id="liLoadMore" runat="server" style="list-style: none; margin-top: 15px; margin-bottom: 15px;">
                                <asp:LinkButton ID="btnLoadMore" runat="server" OnClick="btnLoadMore_Click" style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 11px 16px; background-color: rgba(255,255,255,0.05); border: 1px dashed rgba(255,255,255,0.15); color: rgba(255,255,255,0.7); text-decoration: none; border-radius: 8px; font-size: 13px; font-weight: 500; transition: all 0.25s ease;" onmouseover="this.style.backgroundColor='rgba(255,255,255,0.1)'; this.style.borderColor='rgba(255,255,255,0.3)'; this.style.color='#ffffff';" onmouseout="this.style.backgroundColor='rgba(255,255,255,0.05)'; this.style.borderColor='rgba(255,255,255,0.15)'; this.style.color='rgba(255,255,255,0.7)';">
                                    <i class="fas fa-chevron-down"></i>
                                    <span>Load More Modules</span>
                                </asp:LinkButton>
                            </li>
                        </ContentTemplate>
                    </asp:UpdatePanel>


                </ul>

                <!-- Footer Logged-in Staff Details -->
                <div style="padding: 16px 20px; background-color: rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.06); display: flex; align-items: center; gap: 12px;">
                    <div style="width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-weight: 600; color: #c5a059; border: 1px solid rgba(255,255,255,0.15);">
                        <asp:Literal ID="litAvatar" runat="server" Text="L" />
                    </div>
                    <div style="display: block;">
                        <h4 style="font-size: 13px; font-weight: 600; color: #ffffff; margin: 0;"><asp:Literal ID="litStaffName" runat="server" Text="Librarian" /></h4>
                        <p style="font-size: 11px; color: rgba(255,255,255,0.4); margin: 2px 0 0 0;"><asp:Literal ID="litStaffRole" runat="server" Text="LGC Staff" /></p>
                    </div>
                </div>
            </aside>

            <!-- ══════════════════════════════════════════════════════════
                 MAIN VIEWPORT
            ═══════════════════════════════════════════════════════════ -->
            <main id="mainContent" style="flex: 1; margin-left: 280px; min-width: 0; min-height: 100vh; display: flex; flex-direction: column; position: relative; transition: all 0.25s ease;">
                <!-- Header -->
                <header style="height: 70px; background-color: #ffffff; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; padding: 0 32px; position: sticky; top: 0; z-index: 90; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);">
                    <!-- Left side: Toggle, Logo & Title -->
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <button type="button" onclick="toggleSidebar()" style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 8px; border: 1px solid #e2e8f0; background: #f8fafc; color: #334155; font-size: 16px; cursor: pointer; transition: all 0.2s ease; flex-shrink: 0; margin-right: 4px;" onmouseover="this.style.backgroundColor='#e2e8f0'; this.style.color='#0f172a';" onmouseout="this.style.backgroundColor='#f8fafc'; this.style.color='#334155';">
                            <i class="fas fa-bars"></i>
                        </button>
                        <img src='<%= ResolveUrl("~/Library Management/Images/logo_new.png") %>' alt="Club Logo" style="height: 50px; width: auto; object-fit: contain;" />
                        <div>
                            <h2 style="font-size: 16px; font-weight: 700; color: #0f1e36; margin: 0; line-height: 1.2;">Lahore Gymkhana Club</h2>
                            <span style="font-size: 10px; color: #c5a059; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-top: 2px;">Complaint & Feedback Portal</span>
                        </div>
                    </div>
                    
                    <!-- Right side: Clock & Logout -->
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div style="font-size: 13px; font-weight: 500; color: #64748b; background-color: #f8fafc; border: 1px solid #e2e8f0; padding: 6px 14px; border-radius: 30px; display: flex; align-items: center; gap: 8px;">
                            <span style="width: 8px; height: 8px; border-radius: 50%; background-color: #10b981;"></span>
                            <span id="headerClock">12:00:00 PM</span>
                        </div>
                        <asp:LinkButton ID="lnkChangePassword" runat="server" OnClick="lnkChangePassword_Click" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; font-size: 13px; font-weight: 600; border-radius: 20px; border: 1px solid #e2e8f0; background-color: #f8fafc; color: #0f1e36; text-decoration: none; transition: all 0.25s ease;" onmouseover="this.style.backgroundColor='#e2e8f0'; this.style.borderColor='#cbd5e1';" onmouseout="this.style.backgroundColor='#f8fafc'; this.style.borderColor='#e2e8f0';">
                            <i class="fas fa-key" style="color: #c5a059;"></i>
                            <span>Change Password</span>
                        </asp:LinkButton>
                        <asp:HyperLink runat="server" NavigateUrl="~/Login.aspx" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; font-size: 13px; font-weight: 600; border-radius: 20px; border: 1px solid #fee2e2; background-color: #fef2f2; color: #ef4444; text-decoration: none; transition: all 0.25s ease;" onmouseover="this.style.backgroundColor='#fee2e2'; this.style.borderColor='#fca5a5';" onmouseout="this.style.backgroundColor='#fef2f2'; this.style.borderColor='#fee2e2';">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Logout</span>
                        </asp:HyperLink>
                    </div>
                </header>

                <!-- Employee Info Strip -->
                <div id="divEmpInfo" runat="server" class="no-print" style="background-color: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 12px 32px; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; font-size: 13px; color: #475569;">
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-user" style="color: #c5a059;"></i>
                        <span style="font-weight: 600; color: #0f1e36;">Name:</span>
                        <asp:Label ID="lblEmpName" runat="server" style="color: #64748b;" Text="-"></asp:Label>
                    </div>
                    <span style="color: #cbd5e1;">|</span>
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-id-badge" style="color: #c5a059;"></i>
                        <span style="font-weight: 600; color: #0f1e36;">Designation:</span>
                        <asp:Label ID="lblDesignation" runat="server" style="color: #64748b;" Text="-"></asp:Label>
                    </div>
                    <span style="color: #cbd5e1;">|</span>
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-building" style="color: #c5a059;"></i>
                        <span style="font-weight: 600; color: #0f1e36;">Department:</span>
                        <asp:Label ID="lblDepartment" runat="server" style="color: #64748b;" Text="-"></asp:Label>
                    </div>
                    <span style="color: #cbd5e1;">|</span>
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-sitemap" style="color: #c5a059;"></i>
                        <span style="font-weight: 600; color: #0f1e36;">Sub Department:</span>
                        <asp:Label ID="lblSubDept" runat="server" style="color: #64748b;" Text="-"></asp:Label>
                    </div>
                </div>

                <!-- Page Content (100% width) -->
                <div style="flex: 1; padding: 32px; box-sizing: border-box; width: 100%; max-width: 100%; margin: 0 auto; min-width: 0;">
                    <asp:ContentPlaceHolder ID="cphBody" runat="server" />
                </div>
            </main>
        </div>
    </form>
    
    <script>
        // Real-time Clock logic for header
        function updateClock() {
            var now = new Date();
            var options = { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric', 
                hour: '2-digit', 
                minute: '2-digit', 
                second: '2-digit', 
                hour12: true 
            };
            var clockEl = document.getElementById('headerClock');
            if (clockEl) {
                clockEl.textContent = now.toLocaleString('en-US', options);
            }
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Save focused element and caret position on keyup, focus, or input events
        function saveFocusState() {
            var el = document.activeElement;
            if (el && el.id && (el.tagName === 'INPUT' || el.tagName === 'SELECT' || el.tagName === 'TEXTAREA')) {
                sessionStorage.setItem('focusedElementId', el.id);
                if (el.tagName === 'INPUT' && (el.type === 'text' || el.type === 'search')) {
                    try {
                        sessionStorage.setItem('focusedCaretStart', el.selectionStart);
                        sessionStorage.setItem('focusedCaretEnd', el.selectionEnd);
                    } catch (e) {}
                }
            }
        }

        document.addEventListener('focusin', saveFocusState);
        document.addEventListener('input', saveFocusState);
        document.addEventListener('keyup', saveFocusState);

        // Restore focus and cursor positions
        function restoreFocusState() {
            var id = sessionStorage.getItem('focusedElementId');
            if (id) {
                var el = document.getElementById(id);
                if (el) {
                    el.focus();
                    if (el.tagName === 'INPUT' && (el.type === 'text' || el.type === 'search')) {
                        var start = sessionStorage.getItem('focusedCaretStart');
                        var end = sessionStorage.getItem('focusedCaretEnd');
                        if (start !== null && end !== null) {
                            try {
                                el.setSelectionRange(parseInt(start), parseInt(end));
                            } catch (e) {}
                        }
                    }
                }
            }
        }

        // Restore focus on initial page load
        window.addEventListener('DOMContentLoaded', restoreFocusState);

        // Restore focus after ASP.NET AJAX partial postbacks
        if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
            var prm = Sys.WebForms.PageRequestManager.getInstance();
            prm.add_endRequest(function() {
                restoreFocusState();
            });
        }

        // Toggle sidebar collapse
        function toggleSidebar() {
            var sidebar = document.getElementById('appSidebar');
            var mainContent = document.getElementById('mainContent');
            if (sidebar && mainContent) {
                if (sidebar.style.width === '0px' || sidebar.style.width === '0') {
                    sidebar.style.width = '280px';
                    sidebar.style.opacity = '1';
                    sidebar.style.pointerEvents = 'auto';
                    mainContent.style.marginLeft = '280px';
                } else {
                    sidebar.style.width = '0px';
                    sidebar.style.opacity = '0';
                    sidebar.style.pointerEvents = 'none';
                    mainContent.style.marginLeft = '0px';
                }
            }
        }

        // Hover-based link prefetching
        document.addEventListener('DOMContentLoaded', function() {
            var links = document.querySelectorAll('aside a');
            links.forEach(function(link) {
                link.addEventListener('mouseenter', function() {
                    var href = this.getAttribute('href');
                    if (href && href.indexOf('.aspx') > -1 && href.indexOf('javascript:') === -1 && href.indexOf('#') === -1) {
                        if (!document.querySelector('link[rel="prefetch"][href="' + href + '"]')) {
                            var prefetch = document.createElement('link');
                            prefetch.rel = 'prefetch';
                            prefetch.href = href;
                            document.head.appendChild(prefetch);
                        }
                    }
                }, { once: true });
            });
        });
    </script>
</body>
</html>
