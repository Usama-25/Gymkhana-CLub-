<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <ReportParameters>
    <ReportParameter Name="FromDate">
      <DataType>String</DataType>
      <Prompt>From Date</Prompt>
    </ReportParameter>
    <ReportParameter Name="ToDate">
      <DataType>String</DataType>
      <Prompt>To Date</Prompt>
    </ReportParameter>
    <ReportParameter Name="GeneratedDate">
      <DataType>String</DataType>
      <Prompt>Generated Date</Prompt>
    </ReportParameter>
  </ReportParameters>
  <DataSets>
    <DataSet Name="NewAdmissionsDataSet">
      <Query>
        <DataSourceName>DummyDataSource</DataSourceName>
        <CommandText>/* Data is supplied programmatically */</CommandText>
      </Query>
      <Fields>
        <Field Name="MemberNo">
          <DataField>MemberNo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MemberName">
          <DataField>MemberName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MemberCategory">
          <DataField>MemberCategory</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MemberType">
          <DataField>MemberType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MemberSince">
          <DataField>MemberSince</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="CreatedDate">
          <DataField>CreatedDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="AccountStatus">
          <DataField>AccountStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <!-- Report Header with Logo and Title -->
          <Rectangle Name="ReportHeader">
            <ReportItems>
              <Image Name="ClubLogo">
                <Source>External</Source>
                <Value>assets/images/report_logo.png</Value>
                <Sizing>FitProportional</Sizing>
                <Top>0cm</Top>
                <Left>7.5cm</Left>
                <Height>2cm</Height>
                <Width>2cm</Width>
              </Image>
              <Textbox Name="ReportTitle">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Lahore Gymkhana Club</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>18pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#1a365d</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Center</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>2.2cm</Top>
                <Left>0cm</Left>
                <Height>0.8cm</Height>
                <Width>17cm</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
              </Textbox>
              <Textbox Name="ReportSubTitle">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>New Admissions Report</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>14pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#2d3748</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Center</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>3cm</Top>
                <Left>0cm</Left>
                <Height>0.6cm</Height>
                <Width>17cm</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
              </Textbox>
              <Textbox Name="DateRange">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=("Period: " &amp; Parameters!FromDate.Value &amp; " to " &amp; Parameters!ToDate.Value)</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>10pt</FontSize>
                          <Color>#718096</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Center</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>3.7cm</Top>
                <Left>0cm</Left>
                <Height>0.5cm</Height>
                <Width>17cm</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
