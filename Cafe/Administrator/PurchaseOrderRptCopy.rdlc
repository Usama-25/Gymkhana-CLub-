        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>1.	Definitions</Value>
                <Style>
                  <FontFamily>times New Roman</FontFamily>
                  <FontSize>11pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve">
</Value>
                <Style>
                  <FontFamily>times New Roman</FontFamily>
